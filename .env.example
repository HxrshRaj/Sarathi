# ─────────────────────────────────────────────────────────────
# CodePilot — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Runtime
ENV=development                       # development | test | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Datastores
# Inside docker-compose the api/worker reach Postgres at host "postgres:5432".
# From the host (running alembic/pytest directly) use localhost:5433 — the compose
# Postgres is published there to avoid clashing with a locally-installed Postgres.
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@postgres:5432/codepilot
DATABASE_URL_SYNC=postgresql+psycopg://codepilot:codepilot@postgres:5432/codepilot
REDIS_URL=redis://redis:6379/0

# Security
ENCRYPTION_KEY=                       # `python -m app.scripts.gen_key` -> Fernet key
SESSION_SECRET=change-me-32-bytes-min
CORS_ORIGINS=http://localhost:3000

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo,read:user

# LLM provider
LLM_PROVIDER=anthropic                # anthropic | fake
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=claude-sonnet-5
LLM_JUDGE_MODEL=claude-sonnet-5

# Embeddings
EMBEDDING_PROVIDER=fastembed          # fastembed | voyage | hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
VOYAGE_API_KEY=

# Agent run limits
MAX_TOKENS=400000
MAX_COST_USD=2.00
MAX_ITERATIONS=6
MAX_REPAIR_ITERATIONS=3
MAX_RUNTIME_S=1200
RETRIEVAL_TOKEN_BUDGET=12000

# Sandbox
SANDBOX_IMAGE_PYTHON=codepilot/sandbox-python:latest
SANDBOX_IMAGE_NODE=codepilot/sandbox-node:latest
SANDBOX_TIMEOUT_S=120
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
RUN_WORKSPACE_ROOT=/data/workspaces
WORKSPACE_TTL_H=48

# Dev only
DEV_AUTH_BYPASS=true                  # refused when ENV=production
